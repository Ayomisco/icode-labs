# ─── Database ────────────────────────────────────────────────
# Neon serverless Postgres connection string
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────
# Any long random string — used to sign JWT session cookies
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# ─── App URL ─────────────────────────────────────────────────
# The public base URL of your deployment (no trailing slash)
# Locally this is http://localhost:3000
# On Vercel it will be https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Setup protection ────────────────────────────────────────
# Secret passed as the x-setup-secret header when calling POST /api/setup
# to create the DB tables. Choose any secret string.
SETUP_SECRET=replace_with_a_setup_secret

# ─── First admin account ─────────────────────────────────────
# Used by: npm run setup:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
